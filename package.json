{
  "name": "nexus-gaming-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEXUS - Gaming portal + forum platforma (React 19 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/qa/strip-css-bom.mjs && tsc -b && vite build",
    "check:bom": "node scripts/qa/strip-css-bom.mjs --check",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "server:dev": "cd server && npm run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server:dev\"",
    "dev:clean": "node scripts/dev.mjs",
    "check:env": "node scripts/check-env.mjs server/.env",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:mojibake": "node scripts/qa/fix-mojibake-all.mjs",
    "fix:mojibake": "node scripts/qa/fix-mojibake-all.mjs --write",
    "pack:source": "node scripts/check-secrets.mjs && node scripts/pack.mjs",
    "setup": "npm install && npm --prefix server install",
    "start:local": "npm run check:env && npm run dev:clean",
    "postinstall": "node scripts/link-contracts.mjs && node scripts/record-install.mjs",
    "pretest": "node scripts/check-install.mjs",
    "check:install": "node scripts/check-install.mjs",
    "ingest:news": "node scripts/ingest-rss.mjs",
    "ingest:news:dry": "node scripts/ingest-rss.mjs --dry-run",
    "ingest:news:enrich": "node scripts/enrich-news.mjs",
    "news:cron:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-cron.ps1",
    "news:cron:remove": "powershell -ExecutionPolicy Bypass -File scripts/setup-cron.ps1 -Remove",
    "test": "npm --prefix server test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run lint && npm run test && npm run lint:css && npm run check:og && npm run check:icons && npm run build && npm run check:prerender",
    "lint": "tsc --noEmit",
    "check:og": "node scripts/generate-og.mjs --verify",
    "generate:og": "node scripts/generate-og.mjs",
    "check:icons": "node scripts/generate-icons.mjs --verify",
    "backup": "node scripts/backup.mjs",
    "backup:data": "node scripts/backup.mjs --data-only",
    "backup:verify": "node scripts/backup.mjs --verify",
    "restore": "node scripts/backup.mjs --restore",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:db": "node scripts/qa/probe-db.mjs --rows",
    "check:features": "node scripts/qa/features-2.7.mjs",
    "lint:css": "node scripts/check-tailwind-vars.mjs && node scripts/check-css-tokens.mjs",
    "shot:design": "node scripts/design/capture-1920.mjs",
    "doc:design": "node scripts/design/build-design-pdf.mjs",
    "archive:design": "node scripts/design/archive-before-design.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2",
    "sonner": "^2.0.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-essentials": "^8.3.6",
    "@storybook/addon-interactions": "^8.3.6",
    "@storybook/blocks": "^8.3.6",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "^8.3.6",
    "@storybook/test": "^8.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "storybook": "^8.3.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
