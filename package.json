{
  "name": "nexus-gaming-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEXUS - Gaming portal + forum platforma (React 19 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "server:dev": "cd server && npm run dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server:dev\"",
    "dev:clean": "node scripts/dev.mjs",
    "check:env": "node scripts/check-env.mjs server/.env",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pack:source": "node scripts/check-secrets.mjs && node scripts/pack.mjs",
    "setup": "npm install && npm --prefix server install",
    "start:local": "npm run check:env && npm run dev:clean",
    "test": "npm --prefix server test",
    "verify": "npm run lint && npm run test && npm run build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2",
    "sonner": "^2.0.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
