# FRONTEND (Vite) — kopiraj u `.env.local`
#
# U razvoju ostavi prazno: Vite proxy prosleđuje /api na http://localhost:4000.
# U produkciji postavi pun URL API-ja (bez završnog /), npr. https://api.nexus.rs
# Alternativa: reverse proxy (Nginx/Vercel rewrites) koji servira /api sa istog domena.

# VITE_API_URL=

# Social profili portala — ikonica bez vrednosti se ne prikazuje (F-29)
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@nexusgaming
# VITE_SOCIAL_TWITCH=https://www.twitch.tv/nexusgaming
# VITE_SOCIAL_GITHUB=https://github.com/nexusgaming
# Javni URL sajta za canonical/OG (F-19)
# VITE_PUBLIC_URL=https://nexus.rs

# 2.6.1 — „Online sada“ (Supabase Realtime)
# Iskoristi ISTI projekat kao backend. ANON (publishable) ključ je javan i sme u
# bundle; service_role ključ NIKAD ne ide u frontend.
# Ako ostane prazno, prsten i dalje radi preko `GET /api/presence` (60s granularnost).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Sentry za frontend (opciono; @sentry/react je instaliran u 2.6.2).
# Bez DSN-a modul je inertan. Sa DSN-om se prijavljuju greške rendera
# (AppErrorBoundary) i nehvatanje u bootstrap-u; URL se šalje bez query stringa.
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=nexus@2.6.2

# 2.6.2 — upload slika (avatar/cover/dokaz) ide kroz POST /api/uploads/*;
# ništa se ne konfiguriše na frontendu (bucket je na backendu).

# Backend podešavanja NE idu ovde — vidi `server/.env.example`.
