{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    // N10 — `contracts/` uvozi `zod`, koji je zavisnost servera (jedan `node_modules`).
    "baseUrl": ".",
    "paths": {
      "zod": ["./server/node_modules/zod"]
    }
  },
  "include": ["vite.config.ts", "scripts/*.d.mts"]
}
