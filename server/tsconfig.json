{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    // N10 — `contracts/` živi u korenu repozitorijuma (deljeni modul), pa je
    // `rootDir` koren projekta: `npm run build` upisuje `server/dist/server/...`.
    // Vite ostaje bez `outDir` promene jer `tsc` ovde služi samo za tipove.
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "zod": ["./node_modules/zod"]
    },
    "types": [
      "node"
    ]
  },
  // N10 — provera ugovora front↔back je deo backend typecheck-a.
  "include": [
    "./**/*.ts",
    "../contracts/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/regressions253.test.ts",
    "tests/regressions254.test.ts",
    "tests/regressions255.test.ts"
  ]
}