# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# JWT secret: required, at least 32 characters. Generate a unique random value.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Supabase service_role key is server-only. Never expose it to Vite/browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role-key>
#
# „Online sada“ (2.6.1) koristi ISTI projekat: server objavljuje prisustvo preko
# Realtime Broadcast kanala `presence:global` sa service_role ključem, pa
# dodatni ključ nije potreban. Frontend koristi VITE_SUPABASE_URL +
# VITE_SUPABASE_ANON_KEY (root .env / .env.local).
# Pokreni `server/schema-2.6.1-presence.sql` da prisustvo preživi restart i
# radi sa više API instanci; bez nje se čuva u memoriji procesa.

# Optional settings
# Proxy: podrazumevano false (bez proxy-ja). Ako si iza Reverse proxy-ja
# (Render/Railway/Heroku) postavi broj hopova (npr. 1) ili listu IP/CIDR adresa.
# TRUST_PROXY=1
RATE_LIMIT_READ_MAX=400
RATE_LIMIT_AUTH_MAX=20
# Limit po nalogu (email) za login/forgot-password, nezavisno od IP-a
# RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_LOOKUP_MAX=60
LOG_LEVEL=info
# Set LOG_FORMAT=json for structured production logs.
# LOG_FORMAT=json
# Optional dedicated signing key for newsletter confirmation/unsubscribe tokens.
# NEWSLETTER_SECRET=replace-with-a-different-random-secret

# === Dev samo ===
# Vraća verificationToken/resetToken/confirmToken u API odgovoru i ispisuje
# linkove u log. Radi ISKLJUČIVO kada je NODE_ENV=development.
# DEV_EXPOSE_TOKENS=1

# Javni URL aplikacije za linkove u mejlovima, canonical i sitemap (F-15/F-19).
# Ako nije postavljen, koristi se PRVI domen iz CLIENT_URL.
# PUBLIC_APP_URL=https://nexus.rs

# === 2.4.4 — email (verifikacija / reset / newsletter) ===
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=NEXUS <noreply@your-domain.com>

# === 2.4.4 — error tracking (opciono, povezan u 2.6.2) ===
# Sa DSN-om se @sentry/node inicijalizuje na startu i svaka 5xx greška
# (errorHandler, unhandledRejection, uncaughtException) ide u Sentry.
# Bez DSN-a modul je inertan — nema mrežnih poziva.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_RELEASE=nexus@2.6.2

# === 2.6.2 — Supabase Storage (upload avatara, cover-a i dokaza deal-a) ===
# Koristi isti SUPABASE_URL / SUPABASE_SERVICE_KEY. Bucket `media` kreira
# migracija `server/schema-2.6.2-storage.sql` (javno čitanje, upis samo service_role).
# SUPABASE_STORAGE_BUCKET=media

# === 2.5.1 — demo seed (samo NODE_ENV=development) ===
# Bez SEED_ADMIN_PASSWORD demo admin `nexus_admin` se NE kreira
# (nema više hardkodovane admin123 lozinke).
# SEED_ADMIN_PASSWORD=<jaka-lokalna-lozinka>

# === 2.5.1 — limiti po korisniku (teme/odgovori na 10 min) ===
# THREAD_RATE_LIMIT=10
# REPLY_RATE_LIMIT=30

# === 2.6.0 — limiti za deals (po korisniku) ===
# DEAL_RATE_LIMIT=10          (nova deal-a na sat)
# DEAL_VOTE_RATE_LIMIT=60     (glasova na 10 min)
# DEAL_PREVIEW_RATE_LIMIT=40  (2.6.2 — čitanje ponude sa prodavnice na 10 min)

# === 2.6.2 — pretraga ===
# RATE_LIMIT_SEARCH_MAX=30    (pretraga na minut po IP-u)
# SEARCH_TS_CONFIG=simple     (vest. konfiguracija; `search-lang` je već normalizovan)

# === 2.6.2 — Supabase Storage (upload avatara, cover slika i dokaza deal-a) ===
# Koristi isti SUPABASE_URL / SUPABASE_SERVICE_KEY. Bucket `media` kreira
# migracija `server/schema-2.6.2-storage.sql` (javno čitanje, upis samo service_role).
# SUPABASE_STORAGE_BUCKET=media

# === 2.6.0 — IGDB (opciono, za autocomplete igara + cover) ===
# IGDB ne koristi jedan API key: kreiraj aplikaciju na https://dev.twitch.tv/console/apps
# i upiši Client ID + Client Secret. Bez ovih vrednosti deals rade normalno,
# samo bez IGDB pretrage (igra se unosi ručno).
 IGDB_CLIENT_ID=n1pzpe3fsuvygponwt88o7jq5gb677
 IGDB_CLIENT_SECRET=<twitch-client-secret>
# Alternativa za testiranje: već izdat OAuth access token (60 dana).
# IGDB_API_KEY=<access-token>

# === 2.4.4 — CLIENT_URL može biti lista domena, razdvojena zapetom ===
# CLIENT_URL=https://nexus.rs,https://www.nexus.rs
